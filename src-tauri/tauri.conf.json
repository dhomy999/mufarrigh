{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "محرر الفيديو العربي",
  "version": "0.1.0",
  "identifier": "com.arabicvideo.editor",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run bundle"
  },
  "app": {
    "windows": [
      {
        "title": "محرر الفيديو العربي",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg"],
    "resources": ["../licenses/*", "../LICENSE", "../LICENSE-THIRD-PARTY.txt"],
    "licenseFile": "../LICENSE-THIRD-PARTY.txt",
    "publisher": "أبو عبدالله",
    "copyright": "© 2026",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
