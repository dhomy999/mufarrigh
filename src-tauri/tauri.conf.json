{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mufarrigh",
  "version": "0.1.0",
  "identifier": "com.mufarrigh.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run bundle"
  },
  "app": {
    "windows": [
      {
        "title": "المفرِّغ",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/ffmpeg"],
    "resources": ["../licenses/*", "../LICENSE", "../LICENSE-THIRD-PARTY.txt"],
    "licenseFile": "../LICENSE-THIRD-PARTY.txt",
    "publisher": "أبو عبدالله",
    "copyright": "© 2026",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dhomy999/mufarrigh/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5RUQ1NEVDMjUwRTRFMUQKUldRZFRnNGw3RlR0aVpKeHh5dlhGS0lYVmw2cVhhTitSWjJrVDF0OXI1bDVIeVp1MFpVUCtmQ3gK"
    }
  }
}
